{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inference.schema.v1.json",
  "title": "Financial Agent Reliability inference configuration (provider <-> model)",
  "description": "PER-323 Stage 1c design contract (C-323-10 frozen). Declares inference providers and the models bound to them. Secrets are never stored here: providers reference the NAME of the environment variable that carries the credential. Additional loader-enforced cross-field rules (provider reference integrity, credential_env uniqueness, allowed_response_model_ids containment, secret-scan gate R1/R2) live in financial_agent_reliability.inference_config.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_type", "schema_version", "providers", "models"],
  "properties": {
    "contract_type": {"const": "inference_config"},
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "semver; major must equal this schema file's major version"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider"}
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "request_parameter_block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "top_p": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "stream": {"type": "boolean"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "api", "base_url", "credential_env"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "description": {"type": "string", "maxLength": 200},
        "api": {"enum": ["openai_chat_completions_compatible"]},
        "base_url": {"type": "string", "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]+)?[^\\s]*$"},
        "credential_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "default_parameters": {"$ref": "#/$defs/request_parameter_block"},
        "tool_choice": {"enum": ["auto"]},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600},
        "preflight_tool_instruction": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "provider", "roles"],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["candidate"]}
        },
        "logical_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "identity_rule": {"enum": ["exact_response_match"]},
        "allowed_response_model_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
        },
        "live_preflight_required": {"type": "boolean"},
        "parameter_overrides": {"$ref": "#/$defs/request_parameter_block"}
      }
    }
  }
}
