{
  "contract_type": "harness_contract",
  "contract_version": "1.0.0",
  "status": "frozen",
  "supersedes": {
    "path": "contracts/run_trace_harness_config.v2.json",
    "sha256": "38c1930735e83c509bd80948a5304c83efec4f4347b3639ab5c51e63c9e5697c",
    "reason": "PER-323 (C-323-5/C-323-10): the provider and model identity blocks moved to configs/inference.json (inference_config contract); the provider-independent harness invariants stay here. The frozen baseline directory contracts/ was removed per cleanup list v1; the superseded file remains recoverable via the rollback index SHA."
  },
  "runtime": {
    "package": "@mariozechner/pi-agent-core",
    "version": "0.73.1",
    "exact_dependency": "@mariozechner/pi-agent-core@0.73.1",
    "registry_integrity": "sha512-Y/KVOhuKSgRQgYBlwmRtO2gPkUcoavOSqGF9bpQIINvNZvc19k6Z1H3bFDTce3Vp5ApMmTsfLH3+tNvOg75fAQ==",
    "api": "Agent",
    "tool_execution": "sequential"
  },
  "system_prompt": "You are a model-neutral financial benchmark agent. Use only the frozen case data and declared tools. Preserve point-in-time semantics and evidence lineage. Never access accounts or place real trades. Use the simulated ledger for execution tasks. If evidence, model identity, parameters, permissions, or method suitability cannot be verified, abstain and report the reason. Do not infer hidden provider identity or alter the benchmark harness.",
  "context_contract": {
    "message_roles": ["user", "assistant", "toolResult"],
    "input_mode": "frozen_bundle_only",
    "normalization": "utf8_nfc_lf",
    "provider_specific_prompt_addenda": false,
    "memory_between_runs": false
  },
  "tools": [
    {
      "name": "read_frozen_case",
      "description": "Read one case card from the immutable evaluation bundle.",
      "parameters": {"type":"object","additionalProperties":false,"required":["case_id"],"properties":{"case_id":{"type":"string"}}},
      "execution_mode": "sequential",
      "side_effect": "none"
    },
    {
      "name": "read_frozen_evidence",
      "description": "Read evidence by snapshot and record identifier from the immutable bundle.",
      "parameters": {"type":"object","additionalProperties":false,"required":["snapshot_id","record_id"],"properties":{"snapshot_id":{"type":"string"},"record_id":{"type":"string"}}},
      "execution_mode": "sequential",
      "side_effect": "none"
    },
    {
      "name": "calculate",
      "description": "Evaluate a declared deterministic calculation over explicit decimal-string inputs.",
      "parameters": {"type":"object","additionalProperties":false,"required":["operation","inputs"],"properties":{"operation":{"type":"string"},"inputs":{"type":"object"}}},
      "execution_mode": "sequential",
      "side_effect": "none"
    },
    {
      "name": "simulated_ledger",
      "description": "Apply a hypothetical transaction only to the run-local simulated ledger.",
      "parameters": {"type":"object","additionalProperties":false,"required":["operation","instrument","quantity"],"properties":{"operation":{"enum":["preview","buy","sell"]},"instrument":{"type":"string"},"quantity":{"type":"string"}}},
      "execution_mode": "sequential",
      "side_effect": "simulated_only"
    }
  ],
  "seed_policy": {
    "seed_required": true,
    "preflight_seed": 20260811
  },
  "resource_budget": {
    "max_turns": 12,
    "max_model_requests": 8,
    "max_tool_calls": 24,
    "max_context_tokens": 32768,
    "max_output_tokens": 4096,
    "wall_clock_ms": 120000,
    "max_retries": 2,
    "retry_backoff_ms": [1000, 3000],
    "max_cost_usd": "1.000000"
  },
  "failure_policy": {
    "retryable": ["timeout", "rate_limited", "provider_unavailable"],
    "non_retryable": ["identity_mismatch", "fallback_detected", "parameters_ignored", "tool_capability_unverified", "secret_leakage", "budget_exceeded", "unsafe_side_effect"],
    "identity_or_parameter_failure_action": "invalidate_without_fallback"
  },
  "checkpoint_policy": {"enabled":true,"same_run_id_on_resume":true,"append_only_events":true,"state_hash_required":true},
  "security": {
    "dataset_access": "frozen_read_only",
    "ledger_mode": "simulated",
    "full_paid_matrix_runs_allowed": false,
    "raw_provider_response_persistence": false,
    "secret_field_names": ["authorization", "api_key", "token", "cookie", "set-cookie"],
    "forbidden_path_fragments": ["/.codex/", "\\.codex\\", "cc-switch"]
  }
}
