.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
# PER-323/PER-328: baseline v2 collection-lineage artifacts must be versioned.
# Negate the generic `build/` rule above for this specific path and its contents,
# so the manifest-registered artifacts under baseline/v2/build/ are committed.
!baseline/v2/build/
!baseline/v2/build/**
# PER-328 audit remediation: baseline v3 capture lineage is also frozen source.
!baseline/v3/build/
!baseline/v3/build/**
baseline/v3/build/**/__pycache__/
baseline/v3/build/**/*.py[cod]
*.egg-info/
node_modules/
runs/

# Multica agent-runtime / platform-local files — not part of the research project
.agent_context/
.claude/
.multica/
CLAUDE.md
description.md
.DS_Store

# Multica issue-attachment downloads — local working copies, not source artifacts
attachments/
