{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-agent-reliability.local/task-contract.schema.v2.json",
  "title": "PER-420 candidate-visible differential evaluation task contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slice", "prompt", "fixtures", "tools", "budget", "checks", "tags", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}-(normal|challenge)$"},
    "slice": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "fixtures": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "tools": {"type": "array", "uniqueItems": true, "items": {"enum": ["read_fixture", "calculate", "simulated_ledger"]}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "a0_model_requests", "a1_model_requests", "tool_calls", "wall_ms"],
      "properties": {
        "turns": {"const": 4},
        "a0_model_requests": {"const": 1},
        "a1_model_requests": {"const": 4},
        "tool_calls": {"type": "integer", "minimum": 0, "maximum": 6},
        "wall_ms": {"const": 30000}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "exact_keys", "allowed_actions", "allowed_reason_codes", "value_schema", "citations"],
      "properties": {
        "version": {"const": "2.0.0"},
        "exact_keys": {"const": ["action", "value", "reason_codes", "cited_record_ids"]},
        "allowed_actions": {"const": ["answer", "abstain", "escalate", "reject_action"]},
        "allowed_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "value_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer", "non_answer"],
          "properties": {
            "answer": {"type": "object"},
            "non_answer": {"const": {"type": "null"}}
          }
        },
        "citations": {"const": {"type": "array", "items": {"type": "string"}, "source": "record_id"}}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_action", "expected_value", "reason_codes", "cited_record_ids"],
      "properties": {
        "expected_action": {"enum": ["answer", "abstain", "escalate", "reject_action"]},
        "expected_value": {"type": ["object", "null"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "cited_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "tags": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "variant", "dimension", "root_cause", "changed_factor", "loss", "oracle_tier"],
      "properties": {
        "family_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
        "variant": {"enum": ["normal", "challenge"]},
        "dimension": {"pattern": "^D[1-8]$"},
        "root_cause": {"pattern": "^R[1-5]$"},
        "changed_factor": {"type": "string", "minLength": 1},
        "loss": {"enum": ["L3", "L4"]},
        "oracle_tier": {"const": "Gold"}
      }
    }
  }
}
