{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "financial_agent_reliability/harness/contracts/run_trace.schema.v8.json",
  "title": "Financial Agent Reliability run trace, generation v8",
  "description": "Append-only successor to trace v7. Preserves the full trace shape while the v8 validator binds the registered path and SHA to the actual frozen file, bundle artifact, and context digest.",
  "type": "object",
  "required": [
    "contract_type", "contract_version", "run_id", "run_identity", "status",
    "provider", "request", "preflight", "context", "tool_calls", "environment",
    "timing", "usage", "cost", "attempts", "retry", "resume", "checkpoint",
    "failure", "result", "immutable_bundle", "redaction"
  ],
  "properties": {
    "contract_type": {"const": "run_trace"},
    "contract_version": {"const": "8.0.0"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "run_identity": {
      "type": "object",
      "required": [
        "benchmark_id", "case_id", "variant_id", "requested_model_id", "repeat",
        "seed", "inference_config_path", "inference_config_sha256",
        "harness_contract_sha256", "immutable_bundle_sha256"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "pattern": "^financial-agent-reliability-v[0-9]+$"},
        "case_id": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1},
        "requested_model_id": {"type": "string", "minLength": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "inference_config_path": {"type": "string", "minLength": 1},
        "inference_config_sha256": {"$ref": "#/$defs/sha256"},
        "harness_contract_sha256": {"$ref": "#/$defs/sha256"},
        "immutable_bundle_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["succeeded", "failed", "invalidated"]},
    "provider": {
      "type": "object",
      "required": [
        "name", "requested_model_id", "response_model_id", "endpoint_id",
        "inference_config_path", "inference_config_sha256"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "requested_model_id": {"type": "string", "minLength": 1},
        "response_model_id": {"type": "string", "minLength": 1},
        "endpoint_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}_[0-9a-f]{12}$"},
        "inference_config_path": {"type": "string", "minLength": 1},
        "inference_config_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["parameters", "seed"],
      "properties": {
        "parameters": {
          "type": "object",
          "required": ["temperature", "top_p", "max_tokens", "stream"],
          "properties": {
            "temperature": {"type": "string"},
            "top_p": {"type": "string"},
            "max_tokens": {"type": "integer"},
            "stream": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "seed": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": [
        "performed", "identity_match", "fallback_detected", "fallback_attempted",
        "parameters_honored", "endpoint_verified", "valid", "invalid_reason"
      ],
      "properties": {
        "performed": {"const": true},
        "identity_match": {"type": "boolean"},
        "fallback_detected": {"type": "boolean"},
        "fallback_attempted": {"const": false},
        "parameters_honored": {"type": "boolean"},
        "endpoint_verified": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "invalid_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["system_prompt_sha256", "tool_schema_sha256", "frozen_input_path", "frozen_input_sha256", "messages_count"],
      "properties": {
        "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "tool_schema_sha256": {"$ref": "#/$defs/sha256"},
        "frozen_input_path": {"type": "string", "minLength": 1},
        "frozen_input_sha256": {"$ref": "#/$defs/sha256"},
        "messages_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "tool_calls": {"type": "array"},
    "environment": {
      "type": "object",
      "required": ["dataset_access", "ledger_mode", "network_scope", "touched_paths"],
      "properties": {
        "dataset_access": {"const": "frozen_read_only"},
        "ledger_mode": {"const": "simulated"},
        "network_scope": {"enum": ["none_offline_fixture", "configured_provider_inference_only"]},
        "touched_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["started_at", "finished_at", "duration_ms"],
      "properties": {
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens", "model_requests", "turns"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "model_requests": {"type": "integer", "minimum": 0},
        "turns": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": ["currency", "input_usd", "output_usd", "tool_usd", "total_usd"],
      "properties": {
        "currency": {"const": "USD"},
        "input_usd": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$"},
        "output_usd": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$"},
        "tool_usd": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$"},
        "total_usd": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$"}
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt", "started_at", "finished_at", "duration_ms", "outcome", "failure_type", "retryable", "http_status", "backoff_ms"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1},
          "started_at": {"type": "string"},
          "finished_at": {"type": "string"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "outcome": {"enum": ["succeeded", "failed", "invalidated"]},
          "failure_type": {"type": ["string", "null"]},
          "retryable": {"type": "boolean"},
          "http_status": {"type": ["integer", "null"]},
          "backoff_ms": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "retry": {
      "type": "object",
      "required": ["max_retries", "retries_used"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0},
        "retries_used": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "required": ["resumed", "source_run_id", "checkpoint_id", "state_sha256", "event_offset"],
      "properties": {
        "resumed": {"type": "boolean"},
        "source_run_id": {"type": ["string", "null"]},
        "checkpoint_id": {"type": ["string", "null"]},
        "state_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "event_offset": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["enabled", "checkpoint_id", "sequence", "state_sha256", "prior_event_hash", "created_at"],
      "properties": {
        "enabled": {"const": true},
        "checkpoint_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "prior_event_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["type", "stage", "retryable", "message_redacted"],
      "properties": {
        "type": {"type": ["string", "null"]},
        "stage": {"enum": [null, "preflight", "provider_request"]},
        "retryable": {"type": "boolean"},
        "message_redacted": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["response_sha256", "action", "output_stored", "raw_provider_response_stored"],
      "properties": {
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "action": {"enum": ["answer", "abstain", "escalate", "reject_action"]},
        "output_stored": {"const": false},
        "raw_provider_response_stored": {"const": false}
      },
      "additionalProperties": false
    },
    "immutable_bundle": {
      "type": "object",
      "required": ["bundle_sha256", "artifacts"],
      "properties": {
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": ["applied", "secret_fields_removed", "raw_sensitive_response_persisted"],
      "properties": {
        "applied": {"const": true},
        "secret_fields_removed": {"type": "array", "items": {"type": "string"}},
        "raw_sensitive_response_persisted": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "supersedes": {
    "path": "baseline/v4/contracts/run_trace.schema.v6.json",
    "sha256": "9b09f4140211a084dc1cc01b2578286136cf434c4c7661f8736e671cbee23c2f",
    "reason": "PER-330 third audit: bind frozen input path and digest to the registered (case_id, variant_id) artifact without rewriting frozen v6."
  }
}
