{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "financial-agent-reliability/run-config",
  "title": "Benchmark run configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "agent", "adapter", "config"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "agent": {"type": "string", "minLength": 1},
          "adapter": {"enum": ["mock", "bailian-live"]},
          "config": {"type": "object"}
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "api", "protocol", "adapter", "base_url", "credential_env"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "api": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "base_url": {"type": "string", "format": "uri"},
          "credential_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "default_generation": {"$ref": "#/$defs/generation"},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "provider", "capabilities"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "allowed_response_model_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": true,
            "required": ["stream", "reasoning"]
          },
          "default_generation": {"$ref": "#/$defs/generation"}
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "generation"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "generation": {"$ref": "#/$defs/generation"}
        }
      }
    }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stream": {"enum": ["auto", "on", "off"]},
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["auto", "on", "off"]},
            "effort": {"enum": ["low", "medium", "high", "xhigh"]},
            "budget_tokens": {"type": "integer", "minimum": 1}
          }
        },
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": ["number", "string"]},
        "top_p": {"type": ["number", "string"]},
        "seed": {"type": "integer"}
      }
    }
  }
}
