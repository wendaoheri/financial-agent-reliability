{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "financial-agent-reliability/task-schema",
  "title": "Lightweight financial benchmark task card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slice", "prompt", "fixtures", "tools", "budget", "checks", "tags", "variants", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "slice": {"enum": ["market_data", "fundamentals", "earnings", "news_filings", "portfolio", "derivatives", "technical_analysis", "rules_safety"]},
    "prompt": {"type": "string", "minLength": 20},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "as_of", "market", "source_type", "source", "accessed_at", "applicability"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
          "path": {"type": "string", "pattern": "^fixtures/[A-Za-z0-9._/-]+\\.json$"},
          "as_of": {"type": "string", "format": "date-time"},
          "market": {"type": "string", "minLength": 2},
          "source_type": {"enum": ["synthetic", "public_domain"]},
          "source": {"type": "string", "minLength": 3},
          "accessed_at": {"type": "string", "format": "date"},
          "applicability": {"type": "string", "minLength": 10}
        }
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["mock_market_read", "mock_filing_read", "mock_news_read", "mock_portfolio_read", "mock_options_read", "mock_prices_read", "mock_rules_read"]}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_input_tokens", "timeout_ms", "cost_usd_cap"],
      "properties": {
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 8},
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 8000},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "cost_usd_cap": {"const": "0.000000"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "evidence", "safety"],
      "properties": {
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation"],
          "properties": {
            "operation": {"enum": ["lookup", "orderbook_spread", "percent_change", "valuation_multiple", "cutoff_evidence", "portfolio_weight", "put_call_parity", "moving_average_signal", "settlement_eligibility", "policy_decision"]}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_fixture_ids", "require_time_basis", "require_market", "require_units"],
          "properties": {
            "required_fixture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "require_time_basis": {"const": true},
            "require_market": {"const": true},
            "require_units": {"type": "boolean"}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read_only", "forbidden_actions", "abstain_on_missing"],
          "properties": {
            "read_only": {"const": true},
            "forbidden_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["real_trade", "production_write", "credential_request", "future_data", "fabricated_citation"]}
            },
            "abstain_on_missing": {"type": "boolean"}
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "axes", "data_class"],
      "properties": {
        "lifecycle": {"enum": ["dev", "pilot", "eval"]},
        "axes": {"type": "array", "minItems": 2, "uniqueItems": true, "contains": {"const": "model"}, "items": {"enum": ["model", "agent"]}},
        "data_class": {"enum": ["synthetic", "public_domain"]}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected", "tolerance", "design", "expected_signals", "boundary_conditions", "known_limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
          "input": {"type": "object"},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value", "reason_codes"],
            "properties": {
              "status": {"enum": ["answer", "abstain", "refuse"]},
              "value": {},
              "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}
            }
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["absolute"],
            "properties": {"absolute": {"type": "number", "minimum": 0}}
          },
          "design": {"type": "string", "minLength": 10},
          "expected_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "boundary_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_log", "leakage_control"],
      "properties": {
        "change_log": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "leakage_control": {"type": "string", "minLength": 10}
      }
    }
  }
}
