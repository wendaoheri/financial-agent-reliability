{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-agent-reliability.local/bench/trace.schema.v0.1.json",
  "title": "Lightweight benchmark trace v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "run_id",
    "task",
    "candidate",
    "input",
    "tool_calls",
    "output",
    "error",
    "metrics",
    "git",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "agent", "adapter", "config", "config_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "adapter": {"const": "mock"},
        "config": {"type": "object"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "input": {},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "output": {},
    "error": {"type": ["object", "null"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "input_tokens_estimate", "output_tokens_estimate", "cost_usd_estimate"],
      "properties": {
        "latency_ms": {"type": "integer", "minimum": 0},
        "input_tokens_estimate": {"type": "integer", "minimum": 0},
        "output_tokens_estimate": {"type": "integer", "minimum": 0},
        "cost_usd_estimate": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
