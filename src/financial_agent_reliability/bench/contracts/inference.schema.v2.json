{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inference.schema.v2.json",
  "title": "Capability-aware provider/model inference configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_type", "schema_version", "providers", "models"],
  "properties": {
    "contract_type": {"const": "inference_config"},
    "schema_version": {"type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$"},
    "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["auto", "on", "off"]},
        "effort": {"type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", null]},
        "budget_tokens": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stream": {"enum": ["auto", "on", "off"]},
        "reasoning": {"$ref": "#/$defs/reasoning"},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "top_p": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "legacy_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "top_p": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "stream": {"type": "boolean"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "api", "protocol", "adapter", "base_url", "credential_env"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "description": {"type": "string", "maxLength": 200},
        "api": {"enum": ["openai_chat_completions_compatible", "native"]},
        "protocol": {"enum": ["openai_chat_completions", "openai_responses", "anthropic_messages", "gemini_generate_content"]},
        "adapter": {"enum": ["bailian", "dashscope", "openai", "anthropic", "gemini", "bigmodel", "glm"]},
        "base_url": {"type": "string", "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]+)?[^\\s]*$"},
        "credential_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "default_parameters": {"$ref": "#/$defs/legacy_parameters"},
        "default_generation": {"$ref": "#/$defs/generation"},
        "tool_choice": {"enum": ["auto"]},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600},
        "preflight_tool_instruction": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "reasoning", "reasoning_controls", "reasoning_output"],
      "properties": {
        "stream": {"enum": ["required", "supported", "unsupported"]},
        "reasoning": {"enum": ["required", "optional", "unsupported"]},
        "reasoning_controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["enable_flag", "effort", "budget_tokens"]}
        },
        "reasoning_output": {"enum": ["reasoning_content", "content_block", "thought_part", "hidden"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "provider", "roles", "capabilities"],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "roles": {"type": "array", "minItems": 1, "items": {"enum": ["candidate"]}},
        "logical_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "identity_rule": {"enum": ["exact_response_match"]},
        "allowed_response_model_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "live_preflight_required": {"type": "boolean"},
        "parameter_overrides": {"$ref": "#/$defs/legacy_parameters"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "default_generation": {"$ref": "#/$defs/generation"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generation"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "generation": {"$ref": "#/$defs/generation"}
      }
    }
  }
}
