{
  "contract_type": "inference_config",
  "schema_version": "2.0.0",
  "providers": [
    {
      "name": "bailian",
      "description": "Capability-aware Token Plan configuration for PER-390",
      "api": "openai_chat_completions_compatible",
      "protocol": "openai_chat_completions",
      "adapter": "bailian",
      "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
      "credential_env": "BENCH_BAILIAN_API_KEY",
      "default_generation": {
        "stream": "on",
        "reasoning": {"mode": "auto"},
        "max_output_tokens": 512,
        "temperature": "0.600000",
        "top_p": "1.000000"
      },
      "tool_choice": "auto",
      "timeout_seconds": 120,
      "preflight_tool_instruction": "Return the requested strict JSON object."
    }
  ],
  "models": [
    {
      "model_id": "qwen3.8-max",
      "provider": "bailian",
      "roles": ["candidate"],
      "identity_rule": "exact_response_match",
      "allowed_response_model_ids": ["qwen3.8-max"],
      "live_preflight_required": true,
      "capabilities": {
        "stream": "supported",
        "reasoning": "required",
        "reasoning_controls": ["effort", "budget_tokens"],
        "reasoning_output": "reasoning_content"
      },
      "default_generation": {
        "reasoning": {"mode": "on", "effort": "low"}
      }
    },
    {
