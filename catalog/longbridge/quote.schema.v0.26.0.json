{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Real-time quotes for one or more symbols",
  "items": {
    "additionalProperties": true,
    "properties": {
      "change_percentage": {
        "description": "Price change percentage",
        "type": [
          "string",
          "null"
        ]
      },
      "change_value": {
        "description": "Price change value",
        "type": "string"
      },
      "high": {
        "description": "High price",
        "type": "string"
      },
      "last": {
        "description": "Last traded price",
        "type": "string"
      },
      "low": {
        "description": "Low price",
        "type": "string"
      },
      "open": {
        "description": "Open price",
        "type": "string"
      },
      "overnight": {
        "additionalProperties": true,
        "description": "US overnight quote when available",
        "type": "object"
      },
      "post_market": {
        "additionalProperties": true,
        "description": "US post-market quote when available",
        "type": "object"
      },
      "pre_market": {
        "additionalProperties": true,
        "description": "US pre-market quote when available",
        "type": "object"
      },
      "prev_close": {
        "description": "Previous close price",
        "type": "string"
      },
      "status": {
        "description": "Trading status",
        "type": "string"
      },
      "symbol": {
        "description": "Symbol in <CODE>.<MARKET> format",
        "type": "string"
      },
      "turnover": {
        "description": "Traded turnover",
        "type": "string"
      },
      "volume": {
        "description": "Traded volume",
        "type": [
          "number",
          "string"
        ]
      }
    },
    "type": "object"
  },
  "title": "Real-time quotes for one or more symbols",
  "type": "array"
}
