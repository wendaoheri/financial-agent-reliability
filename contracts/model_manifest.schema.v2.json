{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-agent-reliability.local/contracts/model_manifest.schema.v2.json",
  "title": "Frozen Bailian candidate model manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_type", "contract_version", "status", "provider", "endpoint_id_policy", "supersedes", "models"],
  "properties": {
    "contract_type": {"const": "model_manifest"},
    "contract_version": {"const": "2.0.0"},
    "status": {"const": "frozen_before_candidate_runs"},
    "provider": {"const": "bailian"},
    "endpoint_id_policy": {"const": "sha256_origin_prefix_12_no_path_query_or_credentials"},
    "supersedes": {"type": "object"},
    "models": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["logical_label", "requested_model_id", "allowed_response_model_ids", "identity_rule", "live_preflight_required"],
        "properties": {
          "logical_label": {"enum": ["qwen3.8-max", "glm-5.2", "deepseek-v4-pro"]},
          "requested_model_id": {"enum": ["qwen3.8-max", "glm-5.2", "deepseek-v4-pro"]},
          "allowed_response_model_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["qwen3.8-max", "glm-5.2", "deepseek-v4-pro"]}},
          "identity_rule": {"const": "exact_response_match"},
          "live_preflight_required": {"const": true}
        }
      }
    }
  }
}
