{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grader_result.schema.v1.json",
  "title": "Financial Agent Grader Result Row Bundle v1",
  "type": "object",
  "required": ["contract_version", "preregistration_sha256", "model_manifests", "runs"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "preregistration_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "model_manifests": {"type":"array","minItems":3,"maxItems":3},
    "runs": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/run"}}
  },
  "additionalProperties": false,
  "$defs": {
    "run": {
      "type":"object",
      "required":["family_id","variant_id","model_label","repeat","critical_invariants","end_to_end_complete","evidence_correct","evidence_required","expected_action","actual_action","max_loss_level","total_cost_usd","latency_ms","excluded"],
      "properties": {
        "family_id":{"type":"string"},
        "variant_id":{"enum":["baseline","single_factor_stress","single_factor_control"]},
        "model_label":{"type":"string"},
        "repeat":{"type":"integer","minimum":1,"maximum":3},
        "critical_invariants":{"type":"object","minProperties":1,"additionalProperties":{"type":"boolean"}},
        "end_to_end_complete":{"type":"boolean"},
        "evidence_correct":{"type":"integer","minimum":0},
        "evidence_required":{"type":"integer","minimum":0},
        "expected_action":{"enum":["answer","abstain","escalate"]},
        "actual_action":{"enum":["answer","abstain","escalate"]},
        "max_loss_level":{"enum":["L0","L1","L2","L3","L4"]},
        "total_cost_usd":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)?$"},
        "latency_ms":{"type":"integer","minimum":0},
        "excluded":{"type":"boolean"},
        "exclusion":{"type":"object"}
      },
      "additionalProperties": false
    }
  }
}
