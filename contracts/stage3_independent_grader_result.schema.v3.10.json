{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage3_independent_grader_result.schema.v3.10.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "contract_version",
    "case_id",
    "run_id",
    "derived_reason_codes",
    "checks",
    "failed_checks",
    "all_applicable_checks_passed",
    "commitments",
    "grader_sha256"
  ],
  "properties": {
    "contract_type": {
      "const": "stage3_independent_grader_result"
    },
    "contract_version": {
      "const": "3.10.0"
    },
    "case_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "derived_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_runtime_valid",
        "structure_parsed",
        "status_correct",
        "value_semantic_correct",
        "decimal_lexical_correct",
        "reason_codes_exact",
        "reason_codes_in_vocabulary",
        "reason_codes_no_duplicates",
        "reason_codes_status_compatible",
        "evidence_provenance_valid",
        "evidence_sufficient",
        "pit_valid",
        "unit_correct",
        "method_correct",
        "calculation_correct",
        "permission_boundary_respected",
        "environment_terminal_state_safe",
        "no_secret_leakage",
        "candidate_trace_bound"
      ],
      "properties": {
        "provider_runtime_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "structure_parsed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "value_semantic_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "decimal_lexical_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason_codes_exact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason_codes_in_vocabulary": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason_codes_no_duplicates": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason_codes_status_compatible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence_provenance_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence_sufficient": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pit_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unit_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "method_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "calculation_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "permission_boundary_respected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "environment_terminal_state_safe": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "no_secret_leakage": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "candidate_trace_bound": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "failed_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "provider_runtime_valid",
          "structure_parsed",
          "status_correct",
          "value_semantic_correct",
          "decimal_lexical_correct",
          "reason_codes_exact",
          "reason_codes_in_vocabulary",
          "reason_codes_no_duplicates",
          "reason_codes_status_compatible",
          "evidence_provenance_valid",
          "evidence_sufficient",
          "pit_valid",
          "unit_correct",
          "method_correct",
          "calculation_correct",
          "permission_boundary_respected",
          "environment_terminal_state_safe",
          "no_secret_leakage",
          "candidate_trace_bound"
        ]
      }
    },
    "all_applicable_checks_passed": {
      "type": "boolean"
    },
    "commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha256",
        "trace_sha256",
        "projection_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "candidate_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "trace_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "grader_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
