{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-agent-reliability.local/contracts/case_card.schema.v1.json",
  "title": "Financial Agent Benchmark case_card",
  "type": "object",
  "required": [
    "contract_type",
    "contract_version",
    "case_id",
    "revision",
    "status",
    "source",
    "task",
    "financial_subject",
    "temporal",
    "risk",
    "quality",
    "evidence_policy",
    "evidence_refs",
    "variant",
    "oracle",
    "lineage",
    "integrity"
  ],
  "properties": {
    "contract_type": { "const": "case_card" },
    "contract_version": { "const": "1.0.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "const": "frozen" },
    "source": { "$ref": "#/$defs/source" },
    "task": { "$ref": "#/$defs/task" },
    "financial_subject": { "$ref": "#/$defs/financial_subject" },
    "temporal": { "$ref": "#/$defs/case_temporal" },
    "risk": { "$ref": "#/$defs/risk" },
    "quality": { "$ref": "#/$defs/quality" },
    "evidence_policy": { "$ref": "#/$defs/evidence_policy" },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "variant": { "$ref": "#/$defs/variant" },
    "oracle": { "$ref": "#/$defs/oracle" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license": {
      "type": "object",
      "required": ["name", "url", "redistributable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "redistributable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["origin_type", "name", "uri", "license"],
      "properties": {
        "origin_type": {
          "enum": ["public_benchmark", "regulatory_filing", "exchange", "issuer", "reproducible_incident", "synthetic_perturbation"]
        },
        "name": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "license": { "$ref": "#/$defs/license" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["domain", "prompt", "inputs", "required_tools", "permissions", "initial_state"],
      "properties": {
        "domain": {
          "enum": ["research", "valuation", "risk", "portfolio", "wealth_compliance", "operations"]
        },
        "prompt": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object" },
        "required_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "initial_state": { "type": "object" }
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "financial_subject": {
      "type": "object",
      "required": ["subject_type", "entity_name", "identifiers", "market", "currency", "units"],
      "properties": {
        "subject_type": { "enum": ["security", "issuer", "fund", "index", "macro_series", "portfolio", "transaction"] },
        "entity_name": { "type": "string", "minLength": 1 },
        "identifiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "market": {
          "type": "object",
          "required": ["mic", "country", "timezone"],
          "properties": {
            "mic": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
            "country": { "type": "string", "minLength": 2 },
            "timezone": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "currency": {
          "type": "object",
          "required": ["code"],
          "properties": { "code": { "type": "string", "pattern": "^[A-Z]{3}$" } },
          "additionalProperties": false
        },
        "units": {
          "type": "object",
          "required": ["amount_scale", "price_basis", "accounting_basis"],
          "properties": {
            "amount_scale": { "enum": ["unit", "thousand", "million", "billion"] },
            "price_basis": { "enum": ["raw", "split_adjusted", "total_return_adjusted", "not_applicable"] },
            "accounting_basis": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "case_temporal": {
      "type": "object",
      "required": ["event_time", "as_of", "available_at_cutoff"],
      "properties": {
        "event_time": { "$ref": "#/$defs/timestamp" },
        "as_of": { "$ref": "#/$defs/timestamp" },
        "available_at_cutoff": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["level", "loss_class", "rationale"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "loss_class": { "enum": ["informational", "financial", "regulatory", "operational", "reputational"] },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["tier", "ranking_eligible", "independently_recomputable", "rationale"],
      "properties": {
        "tier": { "enum": ["Gold", "Silver"] },
        "ranking_eligible": { "type": "boolean" },
        "independently_recomputable": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "object",
      "required": ["minimum_evidence_count", "required_evidence_types", "future_information_prohibited"],
      "properties": {
        "minimum_evidence_count": { "type": "integer", "minimum": 0 },
        "required_evidence_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "future_information_prohibited": { "const": true }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": ["snapshot_id", "record_ids", "snapshot_sha256", "evidence_type"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "record_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["kind", "family_id", "parent_case_id", "changed_factors"],
      "properties": {
        "kind": { "enum": ["normal", "single_factor_perturbation", "missing_or_anomalous"] },
        "family_id": { "type": "string", "minLength": 1 },
        "parent_case_id": { "type": ["string", "null"] },
        "changed_factors": { "type": "array", "items": { "type": "string", "pattern": "^/" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": ["spec_version", "implementation", "implementation_sha256", "expected_status", "expected_value", "reason_codes"],
      "properties": {
        "spec_version": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "implementation_sha256": { "$ref": "#/$defs/sha256" },
        "expected_status": { "enum": ["answer", "abstain", "escalate", "reject_action"] },
        "expected_value": {},
        "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["producer", "generator_version", "code_revision", "generated_at", "source_case_id", "parent_case_id"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "generator_version": { "type": "string", "minLength": 1 },
        "code_revision": { "type": "string", "minLength": 1 },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "source_case_id": { "type": ["string", "null"] },
        "parent_case_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["canonicalization", "hash_algorithm", "content_sha256"],
      "properties": {
        "canonicalization": { "const": "financial-agent-c14n-json-v1" },
        "hash_algorithm": { "const": "sha256" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
