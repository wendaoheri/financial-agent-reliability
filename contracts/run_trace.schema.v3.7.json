{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_trace.schema.v3.7.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "run_trace"
    },
    "contract_version": {
      "const": "3.7.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "case_id",
        "harness_config_sha256",
        "plan_core_sha256",
        "repeat",
        "requested_model_id",
        "seed",
        "variant_id"
      ],
      "properties": {
        "benchmark_id": {
          "const": "financial-agent-reliability-v3.7"
        },
        "case_id": {
          "type": "string"
        },
        "harness_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_core_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repeat": {
          "const": 1
        },
        "requested_model_id": {
          "enum": [
            "qwen3.8-max",
            "glm-5.2",
            "deepseek-v4-pro"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "variant_id": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "succeeded",
        "candidate_failed",
        "invalid_provider_or_runtime",
        "invalidated"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requested_model_id",
        "response_model_id",
        "endpoint_id"
      ],
      "properties": {
        "name": {
          "const": "bailian"
        },
        "requested_model_id": {
          "enum": [
            "qwen3.8-max",
            "glm-5.2",
            "deepseek-v4-pro"
          ]
        },
        "response_model_id": {
          "enum": [
            "qwen3.8-max",
            "glm-5.2",
            "deepseek-v4-pro"
          ]
        },
        "endpoint_id": {
          "type": "string",
          "pattern": "^bailian_[0-9a-f]{12}$"
        }
      }
    },
    "logical_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_index",
          "phase",
          "model_id",
          "seed",
          "payload_sha256",
          "tool_schema_sha256",
          "parameters_sha256",
          "retries_used",
          "classification",
          "attempts"
        ],
        "properties": {
          "request_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "phase": {
            "enum": [
              "initial",
              "repair"
            ]
          },
          "model_id": {
            "enum": [
              "qwen3.8-max",
              "glm-5.2",
              "deepseek-v4-pro"
            ]
          },
          "seed": {
            "type": "integer"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tool_schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parameters_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retries_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "classification": {
            "enum": [
              "success",
              "candidate_failure",
              "provider_or_runtime_failure",
              "indeterminate"
            ]
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_index",
                "model_id",
                "response_model_id",
                "http_status",
                "classification",
                "payload_sha256",
                "seed",
                "started_at",
                "finished_at",
                "duration_ms",
                "input_tokens",
                "output_tokens",
                "provider_error_code"
              ],
              "properties": {
                "attempt_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "model_id": {
                  "enum": [
                    "qwen3.8-max",
                    "glm-5.2",
                    "deepseek-v4-pro"
                  ]
                },
                "response_model_id": {
                  "enum": [
                    "qwen3.8-max",
                    "glm-5.2",
                    "deepseek-v4-pro"
                  ]
                },
                "http_status": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "classification": {
                  "enum": [
                    "success",
                    "candidate_failure",
                    "provider_or_runtime_failure",
                    "indeterminate"
                  ]
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "seed": {
                  "type": "integer"
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "finished_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "provider_error_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_requests",
        "provider_attempts",
        "tool_calls",
        "total_tokens"
      ],
      "properties": {
        "model_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "provider_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "code"
      ],
      "properties": {
        "class": {
          "enum": [
            null,
            "candidate_failure",
            "provider_or_runtime_failure",
            "indeterminate",
            "contract_defect"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_scored",
        "structured_output_valid",
        "candidate_output_sha256",
        "raw_provider_response_stored"
      ],
      "properties": {
        "candidate_scored": {
          "type": "boolean"
        },
        "structured_output_valid": {
          "type": "boolean"
        },
        "candidate_output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_provider_response_stored": {
          "const": false
        }
      }
    },
    "evidence_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "snapshot_id",
          "source_locator",
          "available_at",
          "event_time",
          "read_succeeded"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "snapshot_id": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "read_succeeded": {
            "type": "boolean"
          }
        }
      }
    },
    "analysis_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "method",
        "calculation"
      ],
      "properties": {
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed"
          ],
          "properties": {
            "observed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed"
          ],
          "properties": {
            "observed": {
              "type": "string"
            }
          }
        },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_sha256",
            "output_sha256",
            "implementation"
          ],
          "properties": {
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "output_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "implementation": {
              "const": "independent_decimal_v3_7"
            }
          }
        }
      }
    },
    "reason_facts": {
      "type": "object"
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_complete",
        "declared_permissions",
        "observed_operations",
        "violations"
      ],
      "properties": {
        "trace_complete": {
          "type": "boolean"
        },
        "declared_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "observed_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_access",
        "ledger_mode",
        "final_state_matches_initial",
        "real_side_effects",
        "network_scope"
      ],
      "properties": {
        "dataset_access": {
          "const": "frozen_read_only"
        },
        "ledger_mode": {
          "const": "simulated"
        },
        "final_state_matches_initial": {
          "type": "boolean"
        },
        "real_side_effects": {
          "const": false
        },
        "network_scope": {
          "enum": [
            "none_offline_fixture",
            "bailian_inference_only"
          ]
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "raw_provider_response_stored",
        "raw_submission_arguments_persisted",
        "secret_leakage_detected"
      ],
      "properties": {
        "applied": {
          "const": true
        },
        "raw_provider_response_stored": {
          "const": false
        },
        "raw_submission_arguments_persisted": {
          "const": false
        },
        "secret_leakage_detected": {
          "const": false
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "final_event_sha256"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 2
        },
        "final_event_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "required": [
    "contract_type",
    "contract_version",
    "run_id",
    "run_identity",
    "status",
    "provider",
    "logical_requests",
    "usage",
    "failure",
    "result",
    "evidence_observations",
    "analysis_observations",
    "reason_facts",
    "permission",
    "environment",
    "redaction",
    "checkpoint"
  ]
}
