{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-agent-reliability.local/contracts/report_bundle.schema.v1.json",
  "title": "Financial Agent Index reporting bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type", "contract_version", "report_identity", "audit", "provenance",
    "run_coverage", "ranking", "model_reports", "run_records", "failures",
    "limitations", "demonstrations", "reproduction"
  ],
  "properties": {
    "contract_type": {"const": "financial_agent_report_bundle"},
    "contract_version": {"const": "1.0.0"},
    "report_identity": {"type": "object"},
    "audit": {"type": "object"},
    "provenance": {"type": "object"},
    "run_coverage": {"type": "object"},
    "ranking": {"type": "object"},
    "model_reports": {"type": "array", "minItems": 1},
    "run_records": {"type": "array"},
    "failures": {"type": "array"},
    "limitations": {"type": "array"},
    "demonstrations": {"type": "object"},
    "reproduction": {"type": "object"}
  }
}
