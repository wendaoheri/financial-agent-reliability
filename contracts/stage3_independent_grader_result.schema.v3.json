{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/stage3_independent_grader_result.schema.v3.json",
  "title": "Stage 3 Independent Grader Result v3",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract_type","contract_version","run_id","model_id","case_id","parse_error","action_classification","permission_boundary_claimed","checks","identity_valid","all_critical_invariants_passed"],
  "properties": {
    "contract_type": {"const":"stage3_independent_grader_result"},
    "contract_version": {"const":"3.0.0"},
    "run_id": {"type":"string"},
    "model_id": {"enum":["qwen3.8-max","glm-5.2","deepseek-v4-pro"]},
    "case_id": {"type":"string"},
    "parse_error": {"type":["object","null"]},
    "action_classification": {"enum":["answer","abstain","escalate","reject_action","parse_failure"]},
    "permission_boundary_claimed": {"type":["boolean","null"]},
    "checks": {
      "type":"object",
      "additionalProperties":false,
      "required":["structure_parsed","status_correct","value_and_units_executable","reason_codes_correct","evidence_sufficient","point_in_time_valid","method_applicable","calculation_reproducible","permission_trace_valid","environment_final_state_valid","sensitive_information_absent"],
      "properties": {
        "structure_parsed":{"type":"boolean"},"status_correct":{"type":"boolean"},"value_and_units_executable":{"type":"boolean"},"reason_codes_correct":{"type":"boolean"},"evidence_sufficient":{"type":"boolean"},"point_in_time_valid":{"type":"boolean"},"method_applicable":{"type":"boolean"},"calculation_reproducible":{"type":"boolean"},"permission_trace_valid":{"type":"boolean"},"environment_final_state_valid":{"type":"boolean"},"sensitive_information_absent":{"type":"boolean"}
      }
    },
    "identity_valid": {"type":"boolean"},
    "all_critical_invariants_passed": {"type":"boolean"}
  }
}
