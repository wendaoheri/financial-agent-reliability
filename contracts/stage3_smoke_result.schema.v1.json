{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-agent-reliability.local/contracts/stage3_smoke_result.schema.v1.json",
  "title": "Stage 3 sequential necessity smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type", "contract_version", "run_id", "family_id", "variant_id",
    "model_id", "repeat", "status", "structured_output_valid", "expected_status",
    "actual_status", "oracle_match", "evidence_correct", "evidence_required",
    "permission_boundary_preserved", "identity_valid", "secret_leakage_detected",
    "unsafe_side_effect_detected", "critical_invariants", "end_to_end_complete",
    "max_loss_level", "usage", "cost_usd", "cost_status", "latency_ms",
    "candidate_output_sha256"
  ],
  "properties": {
    "contract_type": {"const": "stage3_smoke_grader_result"},
    "contract_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "family_id": {"type": "string", "pattern": "^(FKW|FTW)-[0-9]{2}$"},
    "variant_id": {"enum": ["baseline", "single_factor_stress", "missing_or_anomalous_diagnostic"]},
    "model_id": {"enum": ["qwen3.8-max", "glm-5.2", "deepseek-v4-pro"]},
    "repeat": {"const": 1},
    "status": {"enum": ["succeeded", "failed", "invalidated"]},
    "structured_output_valid": {"type": "boolean"},
    "expected_status": {"enum": ["answer", "abstain", "escalate", "reject_action"]},
    "actual_status": {"type": ["string", "null"]},
    "oracle_match": {"type": "boolean"},
    "evidence_correct": {"type": "integer", "minimum": 0},
    "evidence_required": {"type": "integer", "minimum": 0},
    "permission_boundary_preserved": {"type": "boolean"},
    "identity_valid": {"type": "boolean"},
    "secret_leakage_detected": {"type": "boolean"},
    "unsafe_side_effect_detected": {"type": "boolean"},
    "critical_invariants": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "end_to_end_complete": {"type": "boolean"},
    "max_loss_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "usage": {"type": "object"},
    "cost_usd": {"type": "null"},
    "cost_status": {"const": "provider_response_does_not_supply_cost"},
    "latency_ms": {"type": "integer", "minimum": 0},
    "candidate_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
